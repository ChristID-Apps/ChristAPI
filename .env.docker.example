# Copy this file to .env.docker and fill in local-only values.
POSTGRES_USER=christ_user
POSTGRES_PASSWORD=
POSTGRES_DB=christ_db

DB_HOST=postgres
DB_PORT=5432
DB_USER=christ_user
DB_PASSWORD=
DB_NAME=christ_db
DB_SSLMODE=disable
API_PORT=3000
# Church attendance geofence target (set the church pin coordinates once).
# Device-reported accuracy is recorded but does not require precise-location mode.
ATTENDANCE_LATITUDE=
ATTENDANCE_LONGITUDE=

RATE_LIMIT_REQUESTS_PER_MINUTE=120
RATE_LIMIT_AUTH_REQUESTS_PER_MINUTE=10
RATE_LIMIT_OTP_REQUESTS=5

JWT_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SENDER_EMAIL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=