# Database Configuration
# Local API + Docker PostgreSQL
DB_HOST=localhost
DB_PORT=5433
DB_USER=christ_user
DB_PASSWORD=
DB_NAME=christ_db
DB_SSLMODE=disable

# API Configuration
# Local API listens on 3000
API_PORT=3000
# Church attendance geofence target (set the church pin coordinates once).
# Device-reported accuracy is recorded but does not require precise-location mode.
ATTENDANCE_LATITUDE=
ATTENDANCE_LONGITUDE=
# General request limit per IP per minute (default: 120)
RATE_LIMIT_REQUESTS_PER_MINUTE=120
# Authentication request limit per IP per minute (default: 10)
RATE_LIMIT_AUTH_REQUESTS_PER_MINUTE=10
# OTP verification attempts per IP per 10 minutes (default: 5)
RATE_LIMIT_OTP_REQUESTS=5

# JWT Configuration
JWT_SECRET=

# SMTP Configuration
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SENDER_EMAIL=

# Google OAuth Configuration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
