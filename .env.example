# Database Configuration
# Local API + Docker PostgreSQL
DB_HOST=localhost
DB_PORT=5433
DB_USER=christ_user
DB_PASSWORD=christ_password
DB_NAME=christ_db
DB_SSLMODE=disable

# API Configuration
# Local API listens on 3000
API_PORT=3000
# General request limit per IP per minute (default: 120)
RATE_LIMIT_REQUESTS_PER_MINUTE=120
# Authentication request limit per IP per minute (default: 10)
RATE_LIMIT_AUTH_REQUESTS_PER_MINUTE=10
# OTP verification attempts per IP per 10 minutes (default: 5)
RATE_LIMIT_OTP_REQUESTS=5

# JWT Configuration
JWT_SECRET=change-this-to-a-long-random-secret

# SMTP Configuration
SMTP_HOST=host
SMTP_PORT=6969
SMTP_USER=sixseven@gmail.com
SMTP_PASSWORD=sixsevenpassword
SENDER_EMAIL=sixseven

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
